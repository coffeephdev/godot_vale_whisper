[internationalization]

locale/translations_pot_files=PackedStringArray("res://demo/data/dialogue/demo_dialogue.dialogue")

[physics]

3d/physics_engine="GodotPhysics3D"
3d/default_gravity=17.426

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/16_bits=false
2d/shadow_atlas/size=4096
viewport/hdr_2d=true
anti_aliasing/quality/msaa_3d=3
lights_and_shadows/tighter_shadow_caster_culling=false
environment/defaults/default_clear_color=Color(0.174927, 0.240811, 0.364227, 1)
viewport/transparent_background=true

[xr]

shaders/enabled=true
