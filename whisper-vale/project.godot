;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Whisper-Vale"
config/tags=PackedStringArray("3d", "demo", "hihi")
run/main_scene="uid://dnl3whjqlu5jy"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/image="uid://ddjgrx72bu3sc"
config/icon="res://icon.svg"

[autoload]

GameLead="*res://demo/script/Global/game_lead.gd"
DialogueLead="*res://demo/script/Global/dialogue_lead.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/borderless=true

[editor]

movie_writer/movie_file="C:/Users/Light/Videos/godot_whisper_vale.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[global_group]

fly_posts="Points that allows to travel between each others"
fly_roads="fly paths connect fly routes "

