if not QuestLead.is_quest_started_or_completed("wheat")
	Maggy: [[Hello team|OMG hi|Hi dear]] !
	Maggy: [shake rate=20 level=10]Welcome[/shake] in our little town !
	Maggy: Would you be so king to bring me some wheat ?
	Maggy: I really need to wait here for... [wave amp=25 freq=5]Reasons[/wave], you know.
	- Sure !
		Maggy: Oh [wave amp=25 freq=5]really[/wave] ! Thank you thank you [shake rate=20 level=10]thank you ![/shake]
		Maggy: I'll be waiting here !
		do QuestLead.start_quest("wheat")
	- Not right know...
		Maggy: That's alright ! You're busy yourself !
		Maggy: If ever you change your mind, you know where I am !
elif QuestLead.is_quest_started("wheat")
	Maggy: Have you got it ???
	if QuestLead.is_quest_step_completed("wheat", "collect_wheat"):
		Maggy: OMG OMG [shake rate=20 level=10]OMG[/shake]
		Maggy: I can make my daughter an apple pie for her birthday now !!!!
		do QuestLead.set_quest_step_complete("wheat", "talk_maggy")
		Maggy: Thanks a lot !
	else
		Maggy: Oh sorry, I don't let you breathe haha.
		Maggy: I can wait !
else
	Maggy: Hi deary ! Thanks again for your help !
	Maggy: I hope you find yourself at home.
		
Maggy: [[Bye dear|See you|Tshaw]] !